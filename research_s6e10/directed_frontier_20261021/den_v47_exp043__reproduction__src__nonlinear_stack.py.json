from neighborhood_model import array_sha
from scipy.special import expit
from sklearn.metrics import roc_auc_score
from sklearn.model_selection import train_test_split

from runtime import RuntimePaths, find_data_file

PARENT_SHA = "5724eb0a2e303129ab351a535d3d2e7e8bf02d675068727ec2b9345201ffd345"
LINEAR_SHA = "b4da3591febda2610f8e79e81ad3a3554b012287ffc8c35b29d8460899e18650"
FOLD_SHA = "0d2df9a59085ee4ac172f74548ccb3b02d46be5bf5386db2e2d58263ad424c08"
PARAMS = {
    "objective": "binary:logistic",
    "eval_metric": "auc",
    "tree_method": "hist",
    "device": "cuda:0",
    "grow_policy": "lossguide",
    "max_depth": 0,
    "max_leaves": 15,
    "min_child_weight": 100.0,
    "eta": 0.03,
    "subsample": 0.8,
    "colsample_bytree": 0.5,
    "lambda": 10.0,
    "alpha": 0.0,
    "max_bin": 255,
    "base_score": 0.5,
    "seed_per_iteration": True,
    "nthread": 4,
    "verbosity": 1,
}
SPEC = {
    "version": "direct-cuda-nonlinear-stacker-v1",
    "parent": "exp037",
    "members": 201,
    "params": PARAMS,
    "max_rounds": 4000,
    "inner_holdout_fraction": 0.1,
    "early_stopping_rounds": 200,
    "weights": [0.0, 0.05, 0.1, 0.2, 0.35],
    "minimum_conditional_auc_gain": 0.000005,
    "minimum_fold_wins": 4,
    "canonical_composition": "weighted_raw_logits_then_frozen036_correction",
    "parent_correction_used_during_training": False,
    "final_rounds": "integer_median_of_five_inner_selected_rounds",
    "validation": "conditional_meta_only_not_nested_external_base_refits",
    "seed": 2026,
    "xgboost_compatibility": ">=3.2,<4; exact installed version recorded",
}


def require_cuda() -> dict[str, Any]:
    """Check compatible installed CUDA support; never install or fall back."""
    import torch
    import xgboost as xgb

    version = importlib.metadata.version("xgboost")
    parsed = re.match(r"^(\d+)\.(\d+)", version)
    if parsed is None or int(parsed[1]) != 3 or int(parsed[2]) < 2:
        raise RuntimeError("Require installed XGBoost >=3.2,<4; no hidden install")
    if (
        not xgb.build_info().get("USE_CUDA")
        or not torch.cuda.is_available()
        or torch.cuda.device_count() < 1
    ):
        raise RuntimeError("CUDA GPU required; CPU training fallback forbidden")
    return {
        "xgboost_version": version,
        "xgboost_build": xgb.build_info(),
        "torch_version": str(torch.__version__),
        "gpu_count": torch.cuda.device_count(),
        "training_device": "cuda:0",
        "gpu_names": [
            torch.cuda.get_device_name(i) for i in range(torch.cuda.device_count())
        ],
    }


def preflight(
    config: dict[str, Any], paths: RuntimePaths, *, input_root: Path | None = None
) -> dict[str, Any]:
    from global_refresh import compose
    from global_refresh import preflight as parent_preflight

    if (
        config.get("nonlinear_stack") != SPEC
        or config["runtime"]["accelerator"] != "gpu"
        or config["runtime"]["internet"] is not False
        or config["runtime"]["seed"] != 2026
        or config["validation"]["fold_version"] != "v1"
        or config["validation"]["seed"] != 2036
    ):
        raise ValueError("Nonlinear stack recipe or frozen fold policy changed")
    parent = copy.deepcopy(config)
    parent.pop("nonlinear_stack")
    parent["runtime"]["accelerator"] = "cpu"
    inp, correction, checks, _ = parent_preflight(parent, paths, input_root=input_root)
    data = inp.data
    if data.train.shape[1] != 201 or array_sha(data.own_fold) != FOLD_SHA:
        raise ValueError("Expected exact201 and frozen-v1 identities")
    control = find_data_file(
        "artifacts/reference/exp037_anchor/control_exp037.csv", paths
    )
    linear = find_data_file(
        "artifacts/reference/exp037_anchor/parent_exp037_stacker.json", paths
    )
    if file_sha256(control) != PARENT_SHA or file_sha256(linear) != LINEAR_SHA:
        raise ValueError("Exp037 control bytes changed")
    state = json.loads(linear.read_text())
    if state["names"] != data.names:
        raise ValueError("Parent linear member order mismatch")
    prediction, margin = compose(
        data.test, np.array(state["coefficients"]), state["intercept"], correction
    )
    frame = pd.read_csv(control, float_precision="round_trip")
    if not np.array_equal(frame.id, data.test_ids) or not np.allclose(
        prediction, frame.satisfaction, atol=1e-7, rtol=0
    ):
        raise ValueError("Full parent test replay failed")
    return {
        "data": data,
        "correction": correction,
        "checks": checks,
        "control": control,
        "linear_state": state,
        "linear_margin": margin,
    }


def inner_indices(
    training: np.ndarray, target: np.ndarray, seed: int
) -> tuple[np.ndarray, np.ndarray]:
    """Only outer-training rows may choose the number of boosting rounds."""
    a, b = train_test_split(
        training,
        test_size=SPEC["inner_holdout_fraction"],
        random_state=seed,
        stratify=target[training],
    )
    if np.intersect1d(a, b).size or len(a) + len(b) != len(training):
        raise ValueError("Inner split does not partition outer training")
    return a, b


def margins(value: np.ndarray, rows: int) -> np.ndarray:
    value = np.asarray(value, dtype=np.float64)
    if value.shape != (rows,) or not np.isfinite(value).all():
        raise ValueError("Invalid margin vector")
    return value


def evaluate_weights(
    target: np.ndarray, fold: np.ndarray, linear: np.ndarray, tree: np.ndarray
) -> tuple[float, list[dict[str, Any]]]:
    """Small fixed grid on paired conditional OOF; tie-break toward less change."""
    linear, tree = margins(linear, len(target)), margins(tree, len(target))
    baseline = float(roc_auc_score(target, linear))
    base_folds = [
        float(roc_auc_score(target[fold == k], linear[fold == k])) for k in range(5)
    ]
    records = []
    for weight in SPEC["weights"]:
        mixed = (1 - weight) * linear + weight * tree
        per_fold = [
            float(roc_auc_score(target[fold == k], mixed[fold == k])) for k in range(5)
        ]
        score = float(roc_auc_score(target, mixed))
        wins = int(
            sum(new > old for new, old in zip(per_fold, base_folds, strict=True))
        )
        eligible = bool(
            weight == 0
            or (
                score - baseline >= SPEC["minimum_conditional_auc_gain"]
                and wins >= SPEC["minimum_fold_wins"]
            )
        )
        records.append(
            {
                "weight": weight,
                "conditional_oof_auc": score,
                "gain": score - baseline,
                "fold_wins": wins,
                "per_fold_auc": per_fold,
                "eligible_conditional_only": eligible,
            }
        )
    eligible = [r for r in records if r["eligible_conditional_only"]]
    chosen = max(eligible, key=lambda r: (r["conditional_oof_auc"], -r["weight"]))
    return float(chosen["weight"]), records


def compose(
    linear: np.ndarray, tree: np.ndarray, correction: np.ndarray, weight: float
) -> np.ndarray:
    if weight not in SPEC["weights"]:
        raise ValueError("Weight outside predeclared grid")
    size = len(linear)
    linear, tree, correction = [margins(v, size) for v in (linear, tree, correction)]
    return expit((1 - weight) * linear + weight * tree + correction)


def _tree_fit(
    data: Any,
    indices: np.ndarray,
    folder: Path,
    seed: int,
    *,
    rounds: int | None = None,
) -> tuple[Any, dict[str, Any]]:
    """Called only by the guarded remote path; choose inner rounds then refit."""
    import xgboost as xgb

    hardware = require_cuda()
    params = {**PARAMS, "seed": seed}
    names = [f"base_{i:03d}" for i in range(len(data.names))]

    def matrix(rows: np.ndarray) -> Any:
        return xgb.QuantileDMatrix(
            data.train[rows],
            label=data.target[rows],
            feature_names=names,
            max_bin=255,
            nthread=4,
        )

    started = time.monotonic()
    if rounds is None:
        a, b = inner_indices(indices, data.target, seed)
        history = {}
        inner_train = matrix(a)
        inner_valid = xgb.QuantileDMatrix(
            data.train[b],
            label=data.target[b],
            feature_names=names,
            ref=inner_train,
            max_bin=255,
            nthread=4,
        )
        selector = xgb.train(
            params,
            inner_train,
            num_boost_round=SPEC["max_rounds"],
            evals=[(inner_valid, "inner")],
            early_stopping_rounds=SPEC["early_stopping_rounds"],
            evals_result=history,
            verbose_eval=False,
        )
        rounds = int(selector.best_iteration) + 1
        np.savez_compressed(
            folder / "inner_ids.npz",
            train_ids=data.train_ids[a],
            eval_ids=data.train_ids[b],
        )
        (folder / "inner_history.json").write_text(json.dumps(history, indent=2))
        del selector, inner_train, inner_valid
    booster = xgb.train(
        params, matrix(indices), num_boost_round=rounds, verbose_eval=False
    )
    training_config = json.loads(booster.save_config())
    if (
        not training_config["learner"]["generic_param"]["device"].startswith("cuda")
        or booster.num_boosted_rounds() != rounds
        or booster.feature_names != names
        or booster.num_features() != 201
    ):
        raise ValueError("Direct stacker did not train the declared CUDA model")
    booster.save_model(folder / "tree.ubj")
    (folder / "xgb_training_config.json").write_text(
        json.dumps(training_config, indent=2)
    )
    native = xgb.Booster()
    native.load_model(folder / "tree.ubj")
    native.set_param({"device": "cpu", "nthread": 4})
    return native, {
        "rounds": rounds,
        "seed": seed,
        "params": params,
        "hardware": hardware,
        "fit_seconds": time.monotonic() - started,
        "prediction_backend": "reloaded native CPU tree, not CPU training",
    }


def _predict_tree(model: Any, matrix: np.ndarray) -> np.ndarray:
    import xgboost as xgb

    result = []
    for start in range(0, len(matrix), 50000):
        d = xgb.DMatrix(
            matrix[start : start + 50000], feature_names=model.feature_names
        )
        result.append(model.predict(d, output_margin=True))
    return margins(np.concatenate(result), len(matrix))


def fit_fold(
    data: Any, a: np.ndarray, b: np.ndarray, folder: Path, seed: int
) -> tuple[np.ndarray, np.ndarray, dict[str, Any]]:
    from public_stack import fit_stacker

    model, metadata = _tree_fit(data, a, folder, seed)
    tree_margin = _predict_tree(model, data.train[b])
    started = time.monotonic()
    control = fit_stacker(
        replace(
            data,
            train=data.train[a],
            target=data.target[a],
            train_ids=data.train_ids[a],
            own_fold=data.own_fold[a],
        )
    )
    metadata["linear_fit_seconds"] = time.monotonic() - started
    state = {
        "coefficients": control.coef_[0].tolist(),
        "intercept": float(control.intercept_[0]),
    }
    (folder / "linear.json").write_text(json.dumps(state, indent=2))
    linear_margin = (
        data.train[b].astype(np.float64) @ control.coef_[0] + control.intercept_[0]
    )
    return margins(linear_margin, len(b)), tree_margin, metadata


def crossfit(
    data: Any,
    output: Path,
    *,
    learner: Any = None,
    runtime_name: str = "local",
    hardware: dict[str, Any] | None = None,
) -> dict[str, Any]:
    """Exactly one conditional meta OOF per row; resume verified whole folds."""
    if learner is None and runtime_name not in {"kaggle", "colab"}:
        raise RuntimeError("Conditional stacker fitting is remote-only")
    learner = fit_fold if learner is None else learner
    linear, tree = np.full(len(data.target), np.nan), np.full(len(data.target), np.nan)
    coverage = np.zeros(len(data.target), dtype=np.int8)
    output.mkdir(parents=True, exist_ok=True)
    fingerprint = {
        "train": array_sha(data.train),
        "target": array_sha(data.target),
        "ids": array_sha(data.train_ids),
        "fold": array_sha(data.own_fold),
        "names": data.names,
        "runtime": runtime_name,
        "hardware": hardware,
        "recipe": SPEC,
        "source": {p.name: file_sha256(p) for p in Path(__file__).parent.glob("*.py")},
        "versions": {
            n: importlib.metadata.version(n)
            for n in ["numpy", "scikit-learn", "xgboost"]
        },
    }
    records = []
    for k in range(5):
        a, b = np.flatnonzero(data.own_fold != k), np.flatnonzero(data.own_fold == k)
        if (
            not len(a)
            or not len(b)
            or np.intersect1d(data.train_ids[a], data.train_ids[b]).size
        ):
            raise ValueError("Invalid conditional meta fold")
        folder = output / f"fold{k}"
        folder.mkdir(exist_ok=True)
        complete = folder / "complete.json"
        if complete.exists():
            saved = json.loads(complete.read_text())
            if saved["signature"] != fingerprint:
                raise ValueError("Conditional fold cache signature mismatch")
            for name, pin in saved["files"].items():
                if file_sha256(folder / name) != pin:
                    raise ValueError("Conditional fold cache fingerprint mismatch")
            with np.load(folder / "predictions.npz", allow_pickle=False) as z:
                if not np.array_equal(z["ids"], data.train_ids[b]):
                    raise ValueError("Cached fold ID mismatch")
                lr, gb = z["linear"].copy(), z["tree"].copy()
            metadata = saved["metadata"]
        else:
            lr, gb, metadata = learner(data, a, b, folder, 2026 + k)
            lr, gb = margins(lr, len(b)), margins(gb, len(b))
            np.savez_compressed(
                folder / "predictions.npz", ids=data.train_ids[b], linear=lr, tree=gb
            )
            files = {p.name: file_sha256(p) for p in folder.iterdir() if p.is_file()}
            complete.write_text(
                json.dumps(
                    {"signature": fingerprint, "files": files, "metadata": metadata},
                    indent=2,
                )
            )
        linear[b], tree[b] = margins(lr, len(b)), margins(gb, len(b))
        coverage[b] += 1
        records.append({"fold": k, **metadata})
        print(
            {
                "fold": k,
                "rounds": metadata["rounds"],
                "conditional_linear_auc": roc_auc_score(data.target[b], lr),
                "conditional_tree_auc": roc_auc_score(data.target[b], gb),
            },
            flush=True,
        )
    if not np.all(coverage == 1):
        raise ValueError("Conditional meta OOF coverage must equal one")
    weight, comparison = evaluate_weights(data.target, data.own_fold, linear, tree)
    pd.DataFrame(
        {
            "id": data.train_ids,
            "fold": data.own_fold,
            "linear_margin": linear,
            "tree_margin": tree,
        }
    ).to_parquet(output / "conditional_meta_oof.parquet", index=False)
    (output / "comparison.json").write_text(json.dumps(comparison, indent=2))
    return {
        "weight": weight,
        "comparison": comparison,
        "folds": records,
        "coverage_one": True,
    }


def run_nonlinear(
    config: dict[str, Any], paths: RuntimePaths, out: Path
) -> dict[str, Any]:
    if paths.name not in {"kaggle", "colab"}:
        raise RuntimeError("Direct nonlinear stacker training is remote-only")
    hardware = require_cuda()
    verified = preflight(config, paths)
    data = verified["data"]
    result = crossfit(data, out / "meta", runtime_name=paths.name, hardware=hardware)
    rounds = int(np.median([r["rounds"] for r in result["folds"]]))
    final = out / "final"
    final.mkdir(exist_ok=True)
    model, final_training = _tree_fit(
        data, np.arange(len(data.target)), final, 2026, rounds=rounds
    )
    tree = _predict_tree(model, data.test)
    linear = verified["linear_margin"]
    weight = result["weight"]
    prediction = compose(linear, tree, verified["correction"], weight)
    submission = out / "submission.csv"
    if weight == 0:
        shutil.copy2(verified["control"], submission)
    else:
        pd.DataFrame({"id": data.test_ids, "satisfaction": prediction}).to_csv(
            submission, index=False
        )
    reread = pd.read_csv(submission, float_precision="round_trip")
    if not np.array_equal(reread.id, data.test_ids) or not np.allclose(
        reread.satisfaction, prediction, atol=1e-7, rtol=0
    ):
        raise ValueError("Nonlinear final CSV/ID replay mismatch")
    pd.DataFrame(
        {
            "id": data.test_ids,
            "linear_margin": linear,
            "tree_margin": tree,
            "frozen_correction": verified["correction"],
        }
    ).to_parquet(out / "test_components.parquet", index=False)
    shutil.copy2(verified["control"], out / "control_exp037.csv")
    pd.DataFrame(data.ledger).to_csv(out / "input_provenance.csv", index=False)
    state = {
        "recipe": SPEC,
        "weight": weight,
        "names": data.names,
        "final_training": final_training,
        "tree_sha256": file_sha256(final / "tree.ubj"),
        "parent_checks": verified["checks"],
    }
    (out / "nonlinear_state.json").write_text(json.dumps(state, indent=2))
    (out / "environment.json").write_text(
        json.dumps(
            {
                "hardware": hardware,
                "packages": {
                    n: importlib.metadata.version(n)
                    for n in ["numpy", "pandas", "scikit-learn", "xgboost", "torch"]
                },
                "source_sha256": {
                    p.name: file_sha256(p) for p in paths.src_dir.glob("*.py")
                },
                "tracking": config["tracking"],
            },
            indent=2,
        )
    )
    return {
        "status": "completed_conditional_nonlinear_stack"
        if weight
        else "completed_control_retained_no_conditional_gain",
        "metric": "roc_auc",
        "direction": "maximize",
        "overall_oof_auc": None,
        "per_fold_auc": None,
        "public_score": None,
        "selected": "exploratory_not_promoted",
        "conditional_meta": result,
        "selected_tree_weight": weight,
        "final_rounds": rounds,
        "final_fit_seconds": final_training["fit_seconds"],
        "params": SPEC,
        "submission_path": str(submission),
        "submission_sha256": file_sha256(submission),
        "parent_submission_sha256": PARENT_SHA,
        "validation_status": (
            "conditional_meta_only; imported base fits and frozen correction "
            "are not independently cross-fitted here"
        ),
    }
