<th id="A1.T12.5.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t">LoCalPFN-exact-b32</th>
<td id="A1.T12.5.1.3.2" class="ltx_td ltx_align_left ltx_border_t">0.967 <span id="A1.T12.5.1.3.2.1" class="ltx_text" style="font-size:50%;">[0.966-0.968]</span></td>
<td id="A1.T12.5.1.3.3" class="ltx_td ltx_align_left ltx_border_t">0.931 <span id="A1.T12.5.1.3.3.1" class="ltx_text" style="font-size:50%;">[0.930-0.932]</span></td></tr>
